---
// Themed 404 — "beyond the temple walls". Sanctuary-side aesthetic: black,
// the fixed firmament, the pulsing OVS vermillion star, and a path back in.
// Stars are generated deterministically at build time with the same seeded
// PRNG (and seed) as the chamber firmament in prism.js, so even out here the
// sky is the sanctuary's sky. The star SVG + ovsBreath animation mirror the
// OVS Chapel wall 4 star ([id].astro / prism.css) — keep them in sync if the
// chapel's star ever changes.
const title = 'Beyond the temple walls — Leilan.ai';

function mulberry32(seed: number) {
    return function () {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
}
const rand = mulberry32(0x1E11A2);
const starSymbols = ['✧', '✦', '⋆', '✶', '✴', '✹', '⊹', '✵', '✷', '☆', '★'];
const nightPalette = [
    [220, 225, 235], [235, 232, 240],
    [255, 180, 210], [204, 153, 255],
    [140, 210, 245], [160, 240, 185],
    [255, 242, 204], [255, 209, 179],
];
const stars = Array.from({ length: 56 }, () => {
    const [r, g, b] = nightPalette[Math.floor(rand() * nightPalette.length)];
    return {
        x: (rand() * 100).toFixed(2),
        y: (rand() * 100).toFixed(2),
        sym: starSymbols[Math.floor(rand() * starSymbols.length)],
        size: (0.5 + rand() * 0.9).toFixed(2),
        dur: (2.4 + rand() * 4).toFixed(2),
        delay: (-rand() * 6).toFixed(2),
        col: `rgb(${r},${g},${b})`,
    };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Cinzel:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100vh;
        background: #000;
        color: #cfead9;
        overflow-x: hidden;
      }
      body {
        font-family: 'IBM Plex Mono', monospace;
        font-weight: 300;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
      }

      /* --- firmament --- */
      .star {
        position: fixed;
        transform: translate(-50%, -50%);
        pointer-events: none;
        user-select: none;
        animation: twinkle var(--dur) ease-in-out var(--delay) infinite alternate;
      }
      @keyframes twinkle {
        from { opacity: 0.45; }
        to   { opacity: 1; }
      }

      /* --- the vermillion star (after the OVS Chapel wall star) --- */
      .ovs-star {
        width: clamp(8rem, 24vw, 11rem);
        margin: 0 auto 2.4rem;
      }
      .ovs-star svg {
        width: 100%;
        height: auto;
        display: block;
        animation: ovsBreath 5s ease-in-out infinite;
        transform-origin: center center;
      }
      .ovs-letter-text {
        font-family: 'Cinzel', 'Cormorant Garamond', serif;
        font-size: 17px;
        font-weight: 700;
        fill: #2E004F;
        letter-spacing: 0.08em;
      }
      @keyframes ovsBreath {
        0%, 100% {
          opacity: 0.72;
          transform: scale(0.97);
          filter: brightness(0.85) drop-shadow(0 0 6px rgba(196,18,48,0.5))
                                   drop-shadow(0 0 14px rgba(196,18,48,0.25));
        }
        50% {
          opacity: 1.0;
          transform: scale(1.03);
          filter: brightness(1.1) drop-shadow(0 0 12px rgba(196,18,48,0.9))
                                  drop-shadow(0 0 28px rgba(196,18,48,0.55))
                                  drop-shadow(0 0 48px rgba(196,18,48,0.2));
        }
      }

      /* --- words --- */
      main {
        position: relative;
        z-index: 1;            /* lifts main (and its ::before) above the stars */
        text-align: center;
        max-width: 44rem;
      }
      /* A soft clearing in the firmament: painted above the stars but beneath
         the text (z-index -1 inside main's stacking context), so stars fade
         out as they near the words instead of twinkling through them. */
      main::before {
        content: '';
        position: absolute;
        inset: -4rem -6rem;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(ellipse at 50% 50%,
            rgba(0, 0, 0, 0.96) 0%,
            rgba(0, 0, 0, 0.88) 48%,
            rgba(0, 0, 0, 0.5) 70%,
            transparent 88%);
      }
      .code {
        font-size: 2.34rem;
        letter-spacing: 0.35em;
        color: rgba(94, 239, 162, 0.45);
        margin-bottom: 2.2rem;
      }
      h1 {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-weight: 300;
        font-size: clamp(1rem, 4.2vw, 2.15rem);
        white-space: nowrap;
        line-height: 1.35;
        margin: 0 0 1.1rem;
        color: #eee9dc;
      }
      p.sub {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 300;
        font-size: clamp(1.02rem, 3.4vw, 1.2rem);
        color: rgba(207, 234, 217, 0.72);
        margin: 0 0 3rem;
      }
      .paths {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }
      a.path {
        font-size: 0.88rem;
        letter-spacing: 0.08em;
        color: #5eefa2;
        text-decoration: none;
        border: 1px solid rgba(94, 239, 162, 0.35);
        border-radius: 4px;
        padding: 0.7em 1.6em;
        transition: box-shadow 0.3s ease, border-color 0.3s ease, color 0.3s ease;
      }
      a.path:hover {
        border-color: rgba(94, 239, 162, 0.8);
        box-shadow: 0 0 18px rgba(94, 239, 162, 0.35), inset 0 0 12px rgba(94, 239, 162, 0.08);
        color: #8affc4;
      }
      a.faint {
        font-size: 0.78rem;
        color: rgba(94, 239, 162, 0.55);
        text-decoration: none;
        border-bottom: 1px dotted rgba(94, 239, 162, 0.35);
        padding-bottom: 0.1em;
      }
      a.faint:hover { color: #5eefa2; }

      @media (prefers-reduced-motion: reduce) {
        .star, .ovs-star svg { animation: none; }
      }
    </style>
  </head>
  <body>
    {stars.map(s => (
      <span
        class="star"
        style={`left:${s.x}vw; top:${s.y}vh; font-size:${s.size}rem; color:${s.col}; --dur:${s.dur}s; --delay:${s.delay}s;`}
        aria-hidden="true"
      >{s.sym}</span>
    ))}
    <main>
      <div class="code">404</div>
      <div class="ovs-star" aria-hidden="true">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
          <!-- 8-pointed Islamic-geometry star — solid vermillion -->
          <polygon
            points="100,25 113.4,67.7 153,47 132.3,86.6 175,100 132.3,113.4 153,153 113.4,132.3 100,175 86.6,132.3 47,153 67.7,113.4 25,100 67.7,86.6 47,47 86.6,67.7"
            fill="#C41230" stroke="#C41230" stroke-width="1.4" stroke-linejoin="round"
          />
          <!-- Inner octagon (concave void) -->
          <polygon
            points="113.4,67.7 132.3,86.6 132.3,113.4 113.4,132.3 86.6,132.3 67.7,113.4 67.7,86.6 86.6,67.7"
            fill="rgba(196,18,48,0.15)" stroke="#C41230" stroke-width="0.8" opacity="0.7"
          />
          <!-- Thick outer ring -->
          <circle cx="100" cy="100" r="88" fill="none" stroke="#C41230" stroke-width="3" opacity="0.85"/>
          <!-- Centre glow circle -->
          <circle cx="100" cy="100" r="24" fill="rgba(46,0,79,0.25)" stroke="#2E004F" stroke-width="0.8" opacity="0.8"/>
          <!-- O V S lettering -->
          <text x="100" y="100" class="ovs-letter-text" text-anchor="middle" dominant-baseline="central">OVS</text>
        </svg>
      </div>
      <h1>You have wandered beyond the temple walls&hellip;</h1>
      <p class="sub">The place you sought does not exist — or has not yet been dreamed.</p>
      <div class="paths">
        <a class="path" href="/">return to the sanctuary</a>
        <a class="faint" href="/field-notes/">or consult the field notes</a>
      </div>
    </main>
  </body>
</html>
