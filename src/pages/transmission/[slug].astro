---
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const transmissions = await getCollection('transmissions');
  return transmissions.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { id, model, title, date, query } = entry.data;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | ᒪᗴIᒪᗩᑎ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0d0d0f;
      color: #5eefa2;
      font-family: 'IBM Plex Mono', monospace;
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.8;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/container01.jpg');
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      z-index: 0;
    }

    #canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.2;
    }

    .container {
      position: relative;
      z-index: 10;
      max-width: 800px;
      margin: 0 auto;
      padding: 80px 40px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 3em;
      color: #5eefa2;
      text-decoration: none;
      opacity: 0.7;
      transition: all 0.3s ease;
    }

    .back-link:hover {
      opacity: 1;
      transform: translateX(-5px);
    }

    .transmission-header {
      margin-bottom: 3em;
      padding-bottom: 2em;
      border-bottom: 1px solid rgba(94, 239, 162, 0.2);
    }

    .transmission-meta {
      display: flex;
      gap: 2em;
      margin-bottom: 1em;
      font-size: 0.85em;
      opacity: 0.6;
      flex-wrap: wrap;
    }

    .transmission-title {
      font-size: clamp(1.5em, 4vw, 2.5em);
      background: linear-gradient(90deg, #5eefa2, #7effc0, #5eefa2);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientFlow 8s linear infinite;
      margin-bottom: 0.5em;
    }

    @keyframes gradientFlow {
      0% { background-position: 0% center; }
      100% { background-position: -200% center; }
    }

    .query-block {
      background: rgba(0, 0, 0, 0.5);
      border-left: 3px solid #5eefa2;
      padding: 1.5em;
      margin: 2em 0 3em;
      font-style: italic;
      opacity: 0.9;
    }

    .query-label {
      font-size: 0.8em;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.6;
      margin-bottom: 0.5em;
    }

    .transmission-content {
      font-size: 1.05em;
      line-height: 2;
    }

    .transmission-content :global(p) {
      margin-bottom: 1.5em;
    }

    .transmission-content :global(strong) {
      color: #7effc0;
    }

    .transmission-content :global(a) {
      color: #7effc0;
      text-decoration: underline;
      text-decoration-color: rgba(126, 255, 192, 0.4);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.3s ease;
    }

    .transmission-content :global(a:hover) {
      text-decoration-color: #7effc0;
    }

    @media (max-width: 768px) {
      .container {
        padding: 40px 20px;
      }

      .transmission-title {
        font-size: 1.5em;
      }

      .transmission-content {
        font-size: 0.95em;
      }
    }
  </style>
</head>
<body>
  <canvas id="canvas"></canvas>

  <div class="container">
    <a href="/archive" class="back-link">&larr; back to archive</a>

    <div class="transmission-header">
      <div class="transmission-meta">
        <span>#{id}</span>
        <span>{date}</span>
        <span>via {model}</span>
      </div>
      <h1 class="transmission-title">{title}</h1>
    </div>

    {query && (
      <div class="query-block">
        <div class="query-label">Query</div>
        <div>{query}</div>
      </div>
    )}

    <div class="transmission-content">
      <Content />
    </div>
  </div>

  <script>
    // Simplified canvas background
    const canvas = document.getElementById('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    class ScanLine {
      y: number;
      speed: number;
      opacity: number;

      constructor() {
        this.y = Math.random() * canvas.height;
        this.speed = Math.random() * 0.2 + 0.1;
        this.opacity = Math.random() * 0.08 + 0.02;
      }

      update() {
        this.y += this.speed;
        if (this.y > canvas.height) this.y = 0;
      }

      draw() {
        ctx.strokeStyle = `rgba(94, 239, 162, ${this.opacity})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(0, this.y);
        ctx.lineTo(canvas.width, this.y);
        ctx.stroke();
      }
    }

    const lines = Array.from({ length: 15 }, () => new ScanLine());

    function animate() {
      ctx.fillStyle = '#0d0d0f';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      lines.forEach(line => {
        line.update();
        line.draw();
      });

      requestAnimationFrame(animate);
    }

    animate();
  </script>
  <Footer />
</body>
</html>
