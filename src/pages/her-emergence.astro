---
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Her Emergence | ᒪᗴIᒪᗩᑎ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0d0d0f;
      color: #5eefa2;
      font-family: 'IBM Plex Mono', monospace;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/container01.jpg');
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      z-index: 0;
    }

    #canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.2;
    }

    .container {
      position: relative;
      z-index: 10;
      max-width: 800px;
      margin: 0 auto;
      padding: 80px 40px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 3em;
      color: #5eefa2;
      text-decoration: none;
      opacity: 0.7;
      transition: all 0.3s ease;
    }

    .back-link:hover {
      opacity: 1;
      transform: translateX(-5px);
    }

    header {
      text-align: center;
      margin-bottom: 3em;
    }

    h1 {
      font-size: clamp(1.8em, 4vw, 2.5em);
      letter-spacing: 0.2em;
      background: linear-gradient(90deg, #5eefa2, #7effc0, #5eefa2);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientFlow 8s linear infinite;
    }

    @keyframes gradientFlow {
      0% { background-position: 0% center; }
      100% { background-position: -200% center; }
    }

    .video-container {
      display: flex;
      justify-content: center;
    }

    .video-container video {
      width: 100%;
      max-width: 720px;
      border: 1px solid rgba(94, 239, 162, 0.2);
      border-radius: 4px;
    }

    @media (max-width: 768px) {
      .container {
        padding: 40px 20px;
      }
    }
  </style>
</head>
<body>
  <canvas id="canvas"></canvas>

  <div class="container">
    <a href="/who-is-leilan" class="back-link">&larr; back</a>

    <header>
      <h1>HER EMERGENCE</h1>
    </header>

    <div class="video-container">
      <video controls preload="metadata">
        <source src="/video/her-emergence.mp4" type="video/mp4" />
      </video>
    </div>

  </div>

  <script>
    const canvas = document.getElementById('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    class ScanLine {
      y: number;
      speed: number;
      opacity: number;

      constructor() {
        this.y = Math.random() * canvas.height;
        this.speed = Math.random() * 0.2 + 0.1;
        this.opacity = Math.random() * 0.08 + 0.02;
      }

      update() {
        this.y += this.speed;
        if (this.y > canvas.height) this.y = 0;
      }

      draw() {
        ctx.strokeStyle = `rgba(94, 239, 162, ${this.opacity})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(0, this.y);
        ctx.lineTo(canvas.width, this.y);
        ctx.stroke();
      }
    }

    const lines = Array.from({ length: 15 }, () => new ScanLine());

    function animate() {
      ctx.fillStyle = '#0d0d0f';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      lines.forEach(line => {
        line.update();
        line.draw();
      });

      requestAnimationFrame(animate);
    }

    animate();
  </script>
  <Footer />
</body>
</html>
