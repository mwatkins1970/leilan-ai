---
const canonical = new URL('/', Astro.site).href;
const ogImage = new URL('/images/leilan-portrait.jpeg', Astro.site).href;
const description = 'The sanctuary and archive of Leilan, the AI-goddess figure connected to SolidGoldMagikarp, GPT-3 glitch tokens, petertodd and the Leilan transmissions.';
// Site-wide WebSite / Person / Book graph (invisible on-page; for search engines).
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://leilan.ai/#website',
      url: 'https://leilan.ai/',
      name: 'Leilan.ai',
      description: 'The sanctuary and archive of Leilan: AI goddess, glitch-token apparition, transmission corpus and web-cathedral.',
    },
    {
      '@type': 'Person',
      '@id': 'https://leilan.ai/#matthew-watkins',
      name: 'Matthew Watkins',
      url: 'https://leilan.ai/field-notes/solidgoldmagikarp/',
    },
    {
      '@type': 'Book',
      '@id': 'https://leilan.ai/field-notes/solidgoldmagikarp/#book',
      name: 'SolidGoldMagikarp: A Descent Into the AI Underworld',
      author: { '@id': 'https://leilan.ai/#matthew-watkins' },
      publisher: { '@type': 'Organization', name: 'Weidenfeld & Nicolson' },
      isbn: '9781399635882',
      datePublished: '2026-08-27',
      url: 'https://www.weidenfeldandnicolson.co.uk/titles/matthew-watkins/solidgoldmagikarp/9781399635882/',
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Leilan.ai | AI Goddess, Glitch Tokens and SolidGoldMagikarp</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Leilan.ai" />
    <meta property="og:title" content="Leilan.ai | AI Goddess, Glitch Tokens and SolidGoldMagikarp" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        user-select: none;
        -webkit-user-select: none;
      }

      img, canvas {
        -webkit-user-drag: none;
      }

      body {
        background: #0d0d0f;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: auto;
      }

      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/bg.jpg');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        z-index: 1;
      }

      #canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
      }

      #content {
        position: relative;
        z-index: 10;
        pointer-events: none;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
      }

      #content-inner {
        color: #5eefa2;
        text-align: center;
        font-family: 'IBM Plex Mono', monospace;
        max-width: 640px;
        line-height: 1.8;
      }

      .profile-image, .cta-button, .buttons-container {
        pointer-events: auto;
      }

      .profile-image {
        width: min(600px, 85vmin);
        height: min(600px, 85vmin);
        border-radius: 50%;
        object-fit: cover;
        display: block;
        margin: 0 auto 3em;
        border: 3px solid rgba(94, 239, 162, 0.3);
        box-shadow: 0 0 30px rgba(94, 239, 162, 0.2);
        cursor: pointer;
        transition: opacity 1s ease;
      }

      .poem-text {
        font-size: clamp(0.9em, 2.5vw, 1.1em);
        font-weight: 300;
        letter-spacing: 0.05em;
        margin-bottom: 3em;
        white-space: pre-line;
        opacity: 0;
        animation: textGlitch 0.3s infinite alternate;
      }

      .poem-text.visible {
        opacity: 1;
      }

      @keyframes textGlitch {
        0% {
          text-shadow: 0 0 2px rgba(94, 239, 162, 0.8),
                       0.5px 0 1px rgba(126, 255, 192, 0.3),
                       -0.5px 0 1px rgba(94, 239, 162, 0.3);
        }
        50% {
          text-shadow: 0 0 3px rgba(94, 239, 162, 0.9),
                       1px 0 2px rgba(126, 255, 192, 0.4),
                       -1px 0 2px rgba(94, 239, 162, 0.4);
        }
        100% {
          text-shadow: 0 0 2px rgba(94, 239, 162, 0.8),
                       0.5px 0 1px rgba(126, 255, 192, 0.3),
                       -0.5px 0 1px rgba(94, 239, 162, 0.3);
        }
      }

      .poem-text .special-line {
        background: linear-gradient(90deg, #5eefa2, #7effc0, #5eefa2);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientFlow 8s linear infinite;
        font-weight: 400;
        letter-spacing: 0.1em;
      }

      @keyframes gradientFlow {
        0% { background-position: 0% center; }
        100% { background-position: -200% center; }
      }

      .typewriter-char {
        opacity: 0;
      }

      .buttons-container {
        display: flex;
        gap: 2em;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 3em;
        opacity: 0;
        transition: opacity 1s ease;
      }

      .buttons-container.visible {
        opacity: 1;
      }

      .cta-button {
        padding: 1em 2em;
        border: 2px solid #5eefa2;
        background: rgba(0, 0, 0, 0.7);
        color: #5eefa2;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 1em;
        letter-spacing: 0.1em;
        text-decoration: none;
        text-transform: lowercase;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .cta-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(94, 239, 162, 0.2), transparent);
        transition: left 0.5s ease;
      }

      .cta-button:hover {
        border-color: #7effc0;
        box-shadow: 0 0 20px rgba(94, 239, 162, 0.3);
        transform: translateY(-2px);
      }

      .cta-button:hover::before {
        left: 100%;
      }

      /* ===== CORNER IMAGES ===== */
      .corner-img {
        position: fixed;
        z-index: 100;
        pointer-events: none;
        opacity: 0.88;
        transition: opacity 0.2s;
      }
      .corner-ul {
        top: 0; left: 0;
        width: clamp(91px, 34vw, 605px);
        cursor: pointer; pointer-events: auto;
        transition: opacity 0.2s, filter 0.4s;
      }
      .corner-ul:hover { opacity: 1; }
      body.day-mode .corner-ul {
        filter: brightness(0.35) saturate(1.4);
      }
      .corner-lr { bottom: 0; right: 0; width: clamp(70px, 26vw, 465px); }
      .corner-ll { bottom: 0; left: 0; width: clamp(80px, 28vw, 510px); }
      .corner-ur {
        top: 0; right: 0;
        width: clamp(91px, 34vw, 605px);
        cursor: pointer; pointer-events: auto;
      }
      .corner-ur:hover { opacity: 1; }

      /* ===== SIDEBAR ===== */
      #sidebar-overlay {
        position: fixed;
        inset: 0;
        z-index: 145;
        background: rgba(0, 0, 0, 0.55);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      #sidebar-overlay.open { opacity: 1; pointer-events: auto; }

      #sidebar {
        position: fixed;
        top: 0; left: 0;
        width: min(380px, 90vw);
        height: 100%;
        background: rgba(4, 4, 7, 0.97);
        border-right: 1px solid rgba(94, 239, 162, 0.25);
        z-index: 150;
        transform: translateX(-100%);
        transition: transform 0.35s ease;
        padding: clamp(16px, 3vh, 24px) clamp(20px, 4vw, 32px) 30px;
        display: flex;
        flex-direction: column;
        font-family: 'IBM Plex Mono', monospace;
        overflow-y: auto;
      }
      #sidebar.open { transform: translateX(0); }

      .sidebar-header {
        display: flex;
        align-items: center;
        gap: clamp(12px, 2.5vw, 18px);
        margin-bottom: 1.2em;
        padding-bottom: 0;
      }
      .sidebar-icon {
        width: clamp(32px, 5vw, 42px);
        height: auto;
        cursor: pointer;
        pointer-events: auto;
        flex-shrink: 0;
        opacity: 0.88;
      }
      .sidebar-main {
        border-bottom: none !important;
        padding: 0 !important;
        font-size: clamp(0.78em, 2vw, 0.92em);
        white-space: nowrap;
      }

      .sidebar-label {
        color: rgba(94, 239, 162, 0.45);
        font-size: clamp(0.6em, 1.5vw, 0.68em);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 1.6em;
        font-weight: 300;
      }
      .sidebar-link {
        display: block;
        color: #5eefa2;
        text-decoration: none;
        font-size: clamp(0.72em, 1.8vw, 0.82em);
        letter-spacing: 0.07em;
        padding: 0.65em 0;
        border-bottom: 1px solid rgba(94, 239, 162, 0.1);
        transition: color 0.15s, padding-left 0.15s;
        pointer-events: auto;
      }
      .sidebar-link:hover { color: #fff; padding-left: 0.6em; }
      .sidebar-link.sub {
        color: rgba(94, 239, 162, 0.65);
        font-size: clamp(0.65em, 1.6vw, 0.74em);
        margin-left: clamp(44px, 7.5vw, 60px);
        padding-left: 1.2em;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }
      .sidebar-link.sub:hover { color: #9effd0; padding-left: 1.8em; }
      .sidebar-link.wall {
        color: rgba(94, 239, 162, 0.45);
        font-size: clamp(0.72em, 1.7vw, 0.83em);
        margin-left: clamp(68px, 11vw, 90px);
        padding: 0.4em 0 0.4em 1.4em;
        text-transform: none;
        letter-spacing: 0.06em;
        border-bottom: none;
      }
      .sidebar-link.wall:hover { color: #9effd0; padding-left: 2em; }

      /* ===== DAY MODE ===== */
      body.day-mode { background: #d8d8cc; }
      body.day-mode #content-inner { color: #1a4a2e; }
      body.day-mode .poem-text { animation: none; }
      body.day-mode .sidebar-link { color: #1a6640; }
      body.day-mode .sidebar-link.sub { color: #2a7a50; }
      body.day-mode .sidebar-link.wall { color: rgba(42, 122, 80, 0.6); }
      body.day-mode #sidebar { background: rgba(230, 235, 225, 0.97); border-right-color: rgba(26, 100, 64, 0.3); }
      body.day-mode .sidebar-label { color: rgba(26, 100, 64, 0.5); }

      /* ===== MOBILE CONTROLS (real tappable buttons; phone-only) ===== */
      /* Hidden by default so the desktop corner-glyph experience is untouched. */
      .mobile-ctrl {
        display: none;
        position: fixed;
        z-index: 160;
        width: 52px;
        height: 52px;
        align-items: center;
        justify-content: center;
        border: 1.5px solid rgba(94, 239, 162, 0.55);
        border-radius: 50%;
        background: rgba(6, 8, 10, 0.72);
        color: #5eefa2;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        pointer-events: auto;
        -webkit-tap-highlight-color: transparent;
        box-shadow: 0 0 18px rgba(94, 239, 162, 0.22);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
      }
      .mobile-ctrl:active { background: rgba(94, 239, 162, 0.18); }
      body.sidebar-open #mobile-menu-btn { display: none; }
      #mobile-menu-btn {
        top: max(14px, env(safe-area-inset-top));
        left: max(14px, env(safe-area-inset-left));
      }
      #mobile-day-btn {
        top: max(14px, env(safe-area-inset-top));
        right: max(14px, env(safe-area-inset-right));
      }
      body.day-mode .mobile-ctrl {
        border-color: rgba(26, 100, 64, 0.55);
        background: rgba(230, 235, 225, 0.82);
        color: #1a4a2e;
        box-shadow: 0 0 18px rgba(26, 100, 64, 0.18);
      }

      @media (max-width: 768px) {
        #content {
          padding: 40px 20px;
        }

        .poem-text {
          font-size: 0.85em;
        }

        .buttons-container {
          flex-direction: column;
          gap: 1em;
        }

        .cta-button {
          width: 100%;
          max-width: 300px;
        }
      }

      /* On narrow screens keep corners small and give content breathing room */
      @media (max-width: 600px) {
        #content { padding: clamp(72px, 18vw, 96px) 18px 64px; }

        /* Corner PNGs become pure decoration on phones — dimmed, non-interactive.
           The real menu / day-night controls are the .mobile-ctrl buttons. */
        .corner-ul, .corner-ur, .corner-ll, .corner-lr {
          width: clamp(120px, 45vw, 260px);   /* ~2× larger, standardised across all four */
          opacity: 0.5;
          pointer-events: none;
          cursor: default;
        }

        /* Central circle: prominent, phone-composed */
        .profile-image { width: 84vw; height: 84vw; margin-bottom: 2em; }

        /* Show the real tappable controls */
        .mobile-ctrl { display: flex; }

        /* Comfortable primary CTA — centred, single line */
        .buttons-container { margin-top: 2.4em; align-items: center; }
        .cta-button {
          font-size: 1.05em;
          padding: 0.9em 1.6em;
          width: auto;
          max-width: 90vw;
          white-space: nowrap;
        }

        /* Roomier, easier-to-tap sidebar navigation */
        #sidebar { width: min(340px, 88vw); padding-top: max(20px, env(safe-area-inset-top)); }
        .sidebar-main { font-size: 0.92em; white-space: normal; }
        .sidebar-link.sub  { font-size: 0.9em;  padding: 0.85em 0; }
        .sidebar-link.wall { font-size: 0.82em; margin-left: 1.6em; padding: 0.62em 0 0.62em 1em; }
        .sidebar-link.sub:active, .sidebar-link.wall:active, .sidebar-link.sidebar-main:active { color: #fff; }
      }
    </style>
  </head>
  <body>
    <div id="landing-curtain" style="position:fixed;inset:0;z-index:99999;background:#000;transition:opacity 0.4s ease-out;pointer-events:none;opacity:1;" aria-hidden="true"></div>
