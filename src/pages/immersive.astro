                    }
                };
                // Also attempt resume() immediately in case a gesture already occurred
                _imAudioCtx.resume().then(() => {
                    if (_imAudioCtx && _imAudioCtx.state === 'running') {
                        _imAudioCtx.onstatechange = null;
                        doRise();
                    }
                });
            } else {
                doRise();
            }
        }

        function initImmersiveSoundscape() {
            if (_imStarted) return;
            _imStarted = true;

            _imAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const ctx = _imAudioCtx;
            // Fade node: handles smooth in/out independent of the modulated layers,
            // so envelope changes can never click against an LFO contribution.
            const fade = ctx.createGain();
            fade.gain.value = 0;
            // User volume (top-centre slider) — a dedicated node so it never
            // clashes with the fade-in / fade-out ramps applied to `fade`.
            const userVol = ctx.createGain();
            userVol.gain.value = (window.__leilanVolume ?? 1);
            fade.connect(userVol);
            userVol.connect(ctx.destination);
            window.__applyLeilanVolume = (g) => {
                try { userVol.gain.setTargetAtTime(g, ctx.currentTime, 0.03); } catch (e) {}
            };
            const master = ctx.createGain();
            master.gain.value = 0.55;
            master.connect(fade);

            // --- Feedback delay network (reverb-like diffusion) ---
            const dl1 = ctx.createDelay(1.0); dl1.delayTime.value = 0.37;
            const dl2 = ctx.createDelay(1.0); dl2.delayTime.value = 0.53;
            const fb1 = ctx.createGain(); fb1.gain.value = 0.42;
            const fb2 = ctx.createGain(); fb2.gain.value = 0.38;
            const reverbLP = ctx.createBiquadFilter();
            reverbLP.type = 'lowpass'; reverbLP.frequency.value = 2400;
            dl1.connect(fb1); fb1.connect(dl2);
            dl2.connect(fb2); fb2.connect(dl1);
            dl1.connect(reverbLP); dl2.connect(reverbLP);
            reverbLP.connect(master);
            const wetSend = ctx.createGain(); wetSend.gain.value = 0.35;
            wetSend.connect(dl1);

            // --- Layer 1: Rich organ drone (stacked fifths, warm) ---
            const organLP = ctx.createBiquadFilter();
            organLP.type = 'lowpass'; organLP.frequency.value = 800; organLP.Q.value = 1.5;
            organLP.connect(master); organLP.connect(wetSend);

            const organFreqs = [
                { f: 65.4,  t: 'sine',     g: 0.12 },  // C2
                { f: 98.0,  t: 'sine',     g: 0.09 },  // G2
                { f: 130.8, t: 'triangle', g: 0.06 },  // C3
                { f: 196.0, t: 'sine',     g: 0.04 },  // G3
                { f: 261.6, t: 'sine',     g: 0.02 },  // C4
            ];
            const organOscs = organFreqs.map(n => {
                const o = ctx.createOscillator(); o.type = n.t; o.frequency.value = n.f;
                const g = ctx.createGain(); g.gain.value = n.g;
                o.connect(g); g.connect(organLP); o.start(); return o;
            });

            // Organ filter sweep
            const orgLfo = ctx.createOscillator(); orgLfo.type = 'sine'; orgLfo.frequency.value = 0.04;
            const orgLfoG = ctx.createGain(); orgLfoG.gain.value = 300;
            orgLfo.connect(orgLfoG); orgLfoG.connect(organLP.frequency); orgLfo.start();

            // --- Layer 2: Shimmering detuned pairs (ethereal beating) ---
            const shimLP = ctx.createBiquadFilter();
            shimLP.type = 'lowpass'; shimLP.frequency.value = 1600; shimLP.Q.value = 0.7;
            shimLP.connect(master); shimLP.connect(wetSend);

            const shimFreqs = [
                { f: 329.6, g: 0.025 }, { f: 330.2, g: 0.025 }, // E4 pair
                { f: 493.9, g: 0.018 }, // B4
                { f: 659.3, g: 0.012 }, { f: 660.0, g: 0.012 }, // E5 pair
            ];
            const shimOscs = shimFreqs.map(n => {
                const o = ctx.createOscillator(); o.type = 'sine'; o.frequency.value = n.f;
                const g = ctx.createGain(); g.gain.value = n.g;
                o.connect(g); g.connect(shimLP); o.start(); return o;
            });

            const shimLfo = ctx.createOscillator(); shimLfo.type = 'sine'; shimLfo.frequency.value = 0.06;
            const shimLfoG = ctx.createGain(); shimLfoG.gain.value = 400;
            shimLfo.connect(shimLfoG); shimLfoG.connect(shimLP.frequency); shimLfo.start();

            // --- Layer 3: Cascading arpeggio pings (Riley-esque) ---
            const arpGain = ctx.createGain(); arpGain.gain.value = 0.07;
            arpGain.connect(wetSend); arpGain.connect(master);

            const arpScale = [261.6, 293.7, 329.6, 392.0, 440.0, 523.3, 587.3, 659.3, 784.0, 880.0];
            let arpIdx = 0;
            function scheduleArpPing() {
                if (!_imAudioCtx || _imAudioCtx.state === 'closed') return;
                const now = _imAudioCtx.currentTime;
                const freq = arpScale[arpIdx % arpScale.length];
                arpIdx++;
                const o = _imAudioCtx.createOscillator(); o.type = 'sine'; o.frequency.value = freq;
                const env = _imAudioCtx.createGain();
                env.gain.setValueAtTime(0.055, now);
                env.gain.exponentialRampToValueAtTime(0.001, now + 2.8);
                o.connect(env); env.connect(arpGain);
                o.start(now); o.stop(now + 3.0);
                _imArpId = setTimeout(scheduleArpPing, 1500 + Math.random() * 2500);
            }
            _imArpId = setTimeout(scheduleArpPing, 3000);

            // --- Layer 4: Sub-bass foundation ---
            const sub = ctx.createOscillator(); sub.type = 'sine'; sub.frequency.value = 32.7;
            const subG = ctx.createGain(); subG.gain.value = 0.14;
            sub.connect(subG); subG.connect(master); sub.start();

            const subLfo = ctx.createOscillator(); subLfo.type = 'sine'; subLfo.frequency.value = 0.1;
            const subLfoG = ctx.createGain(); subLfoG.gain.value = 0.07;
            subLfo.connect(subLfoG); subLfoG.connect(subG.gain); subLfo.start();

            const allOscs = [...organOscs, ...shimOscs, sub];
            const allLfos = [orgLfo, shimLfo, subLfo];
            _imDroneNodes = { master, fade, allOscs, allLfos };

            // Fade in over 6 seconds via the dedicated fade node
            fade.gain.setValueAtTime(0, ctx.currentTime);
            fade.gain.linearRampToValueAtTime(1, ctx.currentTime + 6);
        }

        function fadeOutImmersiveSoundscape(duration) {
            if (!_imDroneNodes || !_imAudioCtx) return;
            clearTimeout(_imArpId);
            // Ramp the dedicated fade gain — leaves LFOs running so no abrupt
            // modulation jump occurs at fade-out.
            const now = _imAudioCtx.currentTime;
            _imDroneNodes.fade.gain.cancelScheduledValues(now);
            _imDroneNodes.fade.gain.setValueAtTime(_imDroneNodes.fade.gain.value, now);
            _imDroneNodes.fade.gain.linearRampToValueAtTime(0, now + duration);
            setTimeout(() => {
                if (_imDroneNodes) {
                    _imDroneNodes.allOscs.forEach(o => { try { o.stop(); } catch(e) {} });
                    _imDroneNodes.allLfos.forEach(l => { try { l.stop(); } catch(e) {} });
                }
                if (_imAudioCtx) { _imAudioCtx.close(); _imAudioCtx = null; }
                _imDroneNodes = null;
            }, duration * 1000 + 50);
        }

        // Auto-start after 1.5s, with user-gesture fallback for autoplay policy
        setTimeout(() => {
            initImmersiveSoundscape();
            if (_imAudioCtx && _imAudioCtx.state === 'suspended') {
                function resumeImAudio() {
                    if (_imAudioCtx && _imAudioCtx.state === 'suspended') _imAudioCtx.resume();
                    document.removeEventListener('click', resumeImAudio);
                    document.removeEventListener('keydown', resumeImAudio);
                }
                document.addEventListener('click', resumeImAudio);
                document.addEventListener('keydown', resumeImAudio);
            }
        }, 1500);

        // On a reload / back-forward re-entry, hold the whole sequence at frame 0
        // behind the black "breathe and re-enter" gate. The user's click starts
        // the sequence (and resumes audio) fresh from the beginning. On the normal
        // landing→immersive flow there's no gate and the sequence runs immediately.
        let _seqStarted = false;
        function startImmersive() {
            if (_seqStarted) return;
            _seqStarted = true;
            paused = false;
            // Reset the clock so the first frame's delta is ~0 — the sequence
            // begins from the start rather than jumping by the hold duration.
            lastRealTime = Date.now() * 0.001;
            const gate = document.getElementById('reentry-gate');
            if (gate) gate.classList.add('hidden');
            animate();
            // Audio is left to its existing machinery: the 1.5s soundscape timer
            // and the document-level gesture unlock listeners (which the gate
            // click bubbles to), so audio timing on the normal flow is unchanged.
        }

        if (window.__immersiveHold) {
            const gate = document.getElementById('reentry-gate');
            if (gate) {
                gate.classList.remove('hidden');
                gate.addEventListener('click', startImmersive);
                gate.addEventListener('touchstart', startImmersive, { passive: true });
            } else {
                startImmersive();
            }
        } else {
            startImmersive();
        }
    </script>
</body>
</html>
