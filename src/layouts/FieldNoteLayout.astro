---
// Shared shell for the public field-note layer (the "outer cloister").
// Renders all SEO head metadata + JSON-LD, the cloister styling (mirroring
// data.astro / the LessWrong interstitials), and the standard back-links footer.
// Page-specific content (breadcrumb, H1, body, related) is slotted in by the route.

import OrientationGate from '../components/OrientationGate.astro';

interface Props {
    pageTitle: string;                 // full <title> text
    description: string;
    ogType?: 'article' | 'website';
    ogImage?: string;                  // site-relative path; defaults to the landing portrait
    jsonLd?: Record<string, unknown>[];
}

const { pageTitle, description, ogType = 'article', ogImage = '/images/og-card.jpeg', jsonLd = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index,follow" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Leilan.ai" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Space+Mono:wght@400;700&family=Tangerine:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <OrientationGate />
    <main class="field-note">
      <slot />
    </main>

    <footer class="fn-foot">
      <nav class="fn-foot-nav" aria-label="Site">
        <a href="/field-notes/">field notes</a>
        <span aria-hidden="true">·</span>
        <a class="fn-foot-enter" href="/">inner cloister</a>
        <span aria-hidden="true">·</span>
        <a href="/archive/">archive</a>
        <span aria-hidden="true">·</span>
        <a href="/data/">data</a>
      </nav>
      <p class="fn-foot-note">field notes for travellers arriving by search, scholarship or rumour</p>
    </footer>

    <style is:global>
      /* Outer cloister — "Vellum & gold". Warm cream, refined Cormorant
         Garamond, weathered light + a faint surface grain. The constant
         golden eggs are the deeper magic glimpsed through the stone. */
      :root {
        color-scheme: light;
        --bg: #efe6d0;
        --bg-image:
          radial-gradient(circle at 22% 12%, rgba(255,255,255,0.07), transparent 36%),
          radial-gradient(circle at 78% 86%, rgba(176,132,58,0.06), transparent 42%);
        --text: #3d3324;
        --muted: #6f6247;
        --gold: #b0843a;
        --green: #5f6e44;
        --line: rgba(176,132,58,0.30);
        --font-body: 'Cormorant Garamond', Georgia, serif;
        --font-head: 'Cormorant Garamond', Georgia, serif;
        --fs-body: 1.32rem;
        --lh: 1.55;
        --grain-img: radial-gradient(rgba(60,42,20,0.55) 0.5px, transparent 0.7px);
        --grain-amount: 0.10;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        font-family: var(--font-body);
        background-color: var(--bg);
        background-image: var(--bg-image);
        background-attachment: fixed;
        color: var(--text);
        line-height: var(--lh);
        transition: background-color .45s ease, color .45s ease;
      }
      /* Surface grain — a faint tooth over the whole page (per-skin opacity). */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: var(--grain-img);
        background-size: 3px 3px;
        opacity: var(--grain-amount, 0);
      }

      .field-note {
        width: min(820px, calc(100% - 2rem));
        margin: 0 auto;
        padding: clamp(2.5rem, 6vw, 4.5rem) 0 3rem;
      }

      .field-note .breadcrumb {
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        color: var(--muted);
        margin-bottom: 2.2rem;
      }
      .field-note .breadcrumb a { color: var(--muted); text-decoration: none; border-bottom: 1px solid transparent; }
      .field-note .breadcrumb a:hover { color: var(--green); border-bottom-color: var(--green); }
      .field-note .breadcrumb span { opacity: 0.5; margin: 0 0.5rem; }

      .field-note .kicker {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--gold);
        margin: 0 0 0.9rem;
      }

      .field-note h1 {
        font-family: var(--font-head);
        font-size: clamp(1.7rem, 4.6vw, 2.7rem);
        line-height: 1.16;
        color: var(--gold);
        font-weight: 500;
        margin: 0 0 1rem;
      }
      .field-note .dek {
        font-size: clamp(1.05rem, 2.4vw, 1.28rem);
        color: var(--text);
        font-style: italic;
        margin: 0 0 2rem;
        opacity: 0.92;
      }

      .field-note .topnote {
        border: 1px solid var(--line);
        border-left: 3px solid var(--gold);
        background: rgba(216, 184, 106, 0.06);
        padding: 0.9rem 1.2rem;
        margin: 0 0 2rem;
        font-size: 0.95rem;
        color: var(--muted);
      }
      .field-note .topnote p { margin: 0; }
      .field-note .topnote strong { color: var(--text); }

      .field-note .cta-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: clamp(1.8rem, 6vw, 3.6rem);
        margin: 0.8rem 0 3.4rem;
      }
      /* Two gold-on-black eggs floating in the dark page: a near-black shell,
         luminous gold inscription, a soft golden aura that breathes (opposite
         phase). Same egg, two voices — "inner cloister" in an old magickal hand,
         "the void" in a glitching terminal. */
      .field-note .sanctuary-cta,
      .field-note .chamber-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 12rem;
        padding: 1.55rem 1.7rem;
        border-radius: 50%;                   /* an egg, not a box */
        white-space: nowrap;
        text-decoration: none;
        font-size: 1.05rem;
        letter-spacing: 0.04em;
        color: #f3d98a;                       /* gold on black */
        background: radial-gradient(70% 82% at 50% 30%, #1b1409 0%, #0c0a06 68%, #050403 100%);
        border: 1px solid rgba(216, 184, 106, 0.35);
        box-shadow:
          inset 0 1px 0 rgba(243, 217, 138, 0.14),
          0 6px 22px rgba(0, 0, 0, 0.5),                /* floating drop shadow */
          0 0 16px rgba(216, 184, 106, 0.22);           /* faint resting glow */
        text-shadow: 0 0 10px rgba(243, 217, 138, 0.55), 0 0 26px rgba(216, 184, 106, 0.3);
        transition: transform .5s ease, box-shadow .5s ease, color .5s ease, border-color .5s ease, text-shadow .5s ease;
      }
      /* "inner cloister" — a flowing elfin hand */
      .field-note .sanctuary-cta {
        font-family: 'Tangerine', 'Apple Chancery', cursive;
        font-weight: 700;
        font-size: 1.95rem;
        line-height: 1;
        letter-spacing: 0.01em;
        animation: ctaPulse 5s ease-in-out infinite;              /* warm glow-breath */
      }
      /* "the void" — a glitching terminal */
      .field-note .chamber-cta {
        font-family: 'Space Mono', ui-monospace, monospace;
        font-size: 0.92rem;
        letter-spacing: 0.16em;
        text-transform: lowercase;
        animation: voidGlitch 7s steps(1) infinite, ctaPulse 5s ease-in-out infinite;
        animation-delay: 0s, -2.5s;                               /* pulse in opposite phase */
      }
      /* The wall-note CTA — carved "temple wall" inscription (Cinzel caps). */
      .field-note .wall-visit {
        font-family: 'Cinzel', Georgia, serif;
        font-style: normal;
        font-size: 0.82rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        animation: ctaPulse 5s ease-in-out infinite;
        animation-delay: -2.5s;                                   /* opposite phase, no glitch */
      }
      /* The aura that pokes through the page — a blurred golden halo behind the egg. */
      .field-note .sanctuary-cta::before,
      .field-note .chamber-cta::before {
        content: "";
        position: absolute;
        inset: -16px -14px;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgba(243, 217, 138, 0.42), rgba(216, 184, 106, 0.13) 58%, transparent 80%);
        filter: blur(13px);
        z-index: -1;
        opacity: 0.45;
        pointer-events: none;
        animation: ctaAura 5s ease-in-out infinite;
      }
      .field-note .chamber-cta::before { animation-delay: -2.5s; }   /* opposite phase */
      @keyframes ctaAura {
        0%, 100% { opacity: 0.3;  transform: scale(0.94); }
        50%      { opacity: 0.85; transform: scale(1.1); }
      }
      /* The egg breathing slowly — a gentle swell + warm glow (a bare glow is
         invisible gold-on-cream, so the scale carries it). Paired eggs run
         opposite phase, so they alternate. */
      @keyframes ctaPulse {
        0%, 100% {
          transform: scale(0.985);
          box-shadow:
            inset 0 1px 0 rgba(243, 217, 138, 0.14),
            0 6px 22px rgba(0, 0, 0, 0.5),
            0 0 10px rgba(176, 132, 58, 0.15);
        }
        50% {
          transform: scale(1.04);
          box-shadow:
            inset 0 1px 0 rgba(243, 217, 138, 0.28),
            0 9px 28px rgba(0, 0, 0, 0.5),
            0 0 34px rgba(243, 217, 138, 0.6),
            0 0 14px rgba(176, 132, 58, 0.5);
        }
      }
      @keyframes voidGlitch {
        0%, 86%, 100% { text-shadow: 0 0 10px rgba(243,217,138,0.55), 0 0 26px rgba(216,184,106,0.3); }
        88% { text-shadow: -2px 0 rgba(0,255,231,0.75), 2px 0 rgba(255,42,109,0.75), 0 0 10px rgba(243,217,138,0.35); }
        90% { text-shadow: 2px 0 rgba(0,255,231,0.7), -2px 0 rgba(255,42,109,0.7); }
        92% { text-shadow: -1px 0 rgba(0,255,231,0.6), 1px 0 rgba(255,42,109,0.6), 0 0 8px rgba(243,217,138,0.4); }
        94% { text-shadow: 0 0 10px rgba(243,217,138,0.55); }
      }
      /* Golden glow-up + swell on hover (kept — you liked it). */
      .field-note .sanctuary-cta:hover,
      .field-note .chamber-cta:hover {
        animation: none;                         /* hover glow-up wins over the breath */
        transform: translateY(-3px) scale(1.04);
        color: #fff3cf;
        border-color: rgba(243, 217, 138, 0.7);
        box-shadow:
          inset 0 1px 0 rgba(243, 217, 138, 0.25),
          0 12px 30px rgba(0, 0, 0, 0.55),
          0 0 30px rgba(243, 217, 138, 0.55), 0 0 72px rgba(216, 184, 106, 0.4);
      }
      .field-note .sanctuary-cta:hover { text-shadow: 0 0 14px rgba(255,243,207,0.9), 0 0 40px rgba(243,217,138,0.55); }
      .field-note .sanctuary-cta:hover::before,
      .field-note .chamber-cta:hover::before {
        animation: none;             /* hover bloom takes over from the breath */
        opacity: 1;
        transform: scale(1.22);
      }
      @media (prefers-reduced-motion: reduce) {
        .field-note .sanctuary-cta::before,
        .field-note .chamber-cta::before { animation: none; opacity: 0.5; }
        .field-note .sanctuary-cta,
        .field-note .chamber-cta,
        .field-note .wall-visit { animation: none; }
      }

      .field-note .fn-body { font-size: var(--fs-body); overflow-wrap: break-word; }
      .field-note .fn-body p { margin: 0 0 1.15em; }
      .field-note .fn-body h2 {
        font-family: var(--font-head);
        font-size: clamp(1.25rem, 3vw, 1.6rem);
        color: var(--gold);
        font-weight: 500;
        margin: 2.2rem 0 0.8rem;
        line-height: 1.2;
      }
      /* Q&A sub-headings (the "Quick facts and common misconceptions" section
         on what-is-leilan). Real <h3>s rather than bold paragraphs so the
         questions are structurally legible to crawlers and answer-extractors —
         that section exists to correct specific misconceptions, which only
         works if a machine can tell the question from the answer. */
      .field-note .fn-body h3 {
        font-family: var(--font-head);
        font-size: clamp(1.08rem, 2.2vw, 1.28rem);
        color: var(--text);
        font-weight: 600;
        margin: 1.7rem 0 0.5rem;
        line-height: 1.25;
      }
      .field-note .fn-body a { color: var(--green); text-decoration: none; border-bottom: 1px solid var(--line); }
      .field-note .fn-body a:hover { border-bottom-color: var(--green); }
      .field-note .fn-body em { color: var(--text); }
      .field-note .fn-body strong { color: var(--text); }
      .field-note .fn-body blockquote {
        margin: 1.4rem 0;
        padding: 0.6rem 0 0.6rem 1.3rem;
        border-left: 2px solid var(--line);
        color: var(--muted);
        font-style: italic;
      }
      .field-note .fn-body img { max-width: 100%; height: auto; }

      .field-note .related {
        margin-top: 3rem;
        padding-top: 1.6rem;
        border-top: 1px solid var(--line);
      }
      .field-note .related h2 {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--gold);
        margin: 0 0 1rem;
      }
      .field-note .related ul { list-style: none; margin: 0; padding: 0; }
      .field-note .related li { margin: 0 0 0.55rem; }
      .field-note .related a { color: var(--green); text-decoration: none; border-bottom: 1px solid transparent; }
      .field-note .related a:hover { border-bottom-color: var(--green); }

      /* Index listing */
      .field-note .fn-index-group { margin: 2.2rem 0; }
      .field-note .fn-index-group > h2 {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--gold);
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--line);
      }
      .field-note .fn-index-item { margin: 0 0 1.5rem; }
      .field-note .fn-index-item a.fn-index-title {
        font-size: 1.18rem;
        color: var(--green);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .field-note .fn-index-item a.fn-index-title:hover { border-bottom-color: var(--green); }
      .field-note .fn-index-item p { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.98rem; }

      .fn-foot {
        border-top: 1px solid var(--line);
        margin-top: 2rem;
        padding: 2.4rem 1rem 3rem;
        text-align: center;
      }
      .fn-foot-nav { font-size: 0.92rem; letter-spacing: 0.04em; }
      .fn-foot-nav a { color: var(--muted); text-decoration: none; border-bottom: 1px solid transparent; }
      .fn-foot-nav a:hover { color: var(--green); border-bottom-color: var(--green); }
      .fn-foot-nav .fn-foot-enter { color: var(--gold); }
      .fn-foot-nav .fn-foot-enter:hover { color: var(--gold); border-bottom-color: var(--gold); }
      .fn-foot-nav span { opacity: 0.4; margin: 0 0.5rem; }
      .fn-foot-note { color: var(--muted); font-size: 0.82rem; font-style: italic; margin: 1.1rem 0 0; opacity: 0.7; }

      /* ---- Phone portrait: a comfortable reading pass (desktop untouched) ---- */
      @media (max-width: 600px) {
        .field-note {
          width: calc(100% - 2.6rem);            /* ~21px side margins */
          padding-top: clamp(2rem, 9vw, 3rem);
        }
        .field-note .breadcrumb { margin-bottom: 1.8rem; }

        /* Two eggs read better offset on a narrow screen: first upper-left,
           second lower-right — a diagonal rather than a centred stack. */
        .field-note .cta-row {
          flex-direction: column;
          align-items: stretch;
          gap: 1.4rem;
          margin-bottom: 3rem;
        }
        .field-note .cta-row > :first-child { align-self: flex-start; }
        .field-note .cta-row > :last-child  { align-self: flex-end; }
        .field-note .sanctuary-cta,
        .field-note .chamber-cta { max-width: 86vw; }

        /* Roomier footer so the inline nav links are easy to tap */
        .fn-foot { padding: 2rem 1rem 2.6rem; }
        .fn-foot-nav { line-height: 2.1; }
      }
    </style>
  </body>
</html>
