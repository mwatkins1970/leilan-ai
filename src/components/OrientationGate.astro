---
// Portrait "rotate to enter" gate for the cinematic parts of the dream
// (/immersive and /prism/*). Two modes:
//   • cinematic={true}  — placed ON a cinematic page. A pure-CSS overlay shows
//     in portrait; if the page loaded in portrait it reloads on the first
//     landscape so the intro plays fresh & correctly framed.
//   • cinematic={false} — placed on a page that links INTO the dream (landing,
//     field notes). Taps on an /immersive or /prism link while in portrait are
//     held: the gate appears, and navigation fires the moment the phone turns.
interface Props { cinematic?: boolean }
const { cinematic = false } = Astro.props;
---

<div id="portrait-gate" role="dialog" aria-modal="true" aria-label="Turn your device to landscape" data-cinematic={cinematic ? '' : null}>
  <div class="pg-inner">
    <div class="pg-phone" aria-hidden="true"><span class="pg-phone-dot"></span></div>
    <p class="pg-lead">This part of the dream is best entered sideways.</p>
    <p class="pg-sub">Rotate your phone to landscape,<br />or visit from a larger screen for the full environment.</p>
  </div>
</div>

<style>
  #portrait-gate {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 2147483000;                 /* above every page's own chrome */
    align-items: center;
    justify-content: center;
    padding: max(28px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right))
             max(28px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left));
    color: #5eefa2;
    background:
      radial-gradient(circle at 50% 38%, rgba(16, 30, 24, 0.96), rgba(4, 6, 5, 0.985) 70%),
      #030403;
    font-family: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }
  /* Shown by JS on source pages; shown by orientation on cinematic pages. */
  #portrait-gate.open { display: flex; }
  @media (max-width: 900px) and (orientation: portrait) {
    #portrait-gate[data-cinematic] { display: flex; }
  }

  .pg-inner { max-width: 30rem; animation: pgFade 0.9s ease both; }

  .pg-phone {
    width: 46px;
    height: 82px;
    border: 2.5px solid currentColor;
    border-radius: 10px;
    position: relative;
    margin: 0 auto 2rem;
    box-shadow: 0 0 18px rgba(94, 239, 162, 0.35);
    animation: pgTurn 3.6s ease-in-out infinite;
  }
  .pg-phone-dot {
    position: absolute;
    bottom: 6px; left: 50%;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: currentColor;
    transform: translateX(-50%);
    opacity: 0.85;
  }

  .pg-lead {
    font-size: clamp(1.05rem, 5.2vw, 1.4rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.5;
    margin: 0 0 1.2rem;
    text-shadow: 0 0 10px rgba(94, 239, 162, 0.55), 0 0 26px rgba(94, 239, 162, 0.25);
  }
  .pg-sub {
    font-size: clamp(0.82rem, 3.6vw, 0.98rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 1.7;
    margin: 0;
    color: rgba(94, 239, 162, 0.72);
  }

  @keyframes pgTurn {
    0%, 26%   { transform: rotate(0deg); }
    54%, 100% { transform: rotate(90deg); }
  }
  @keyframes pgFade {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-phone { animation: none; }
    .pg-inner { animation: none; }
  }
</style>

<script>
  const gate = document.getElementById('portrait-gate');
  if (gate) {
    const CINEMATIC = /^\/(immersive|prism)(?:\/|$)/;
    const isCinematicPage = gate.hasAttribute('data-cinematic');
    const mq = window.matchMedia('(max-width: 900px) and (orientation: portrait)');
    const isPortrait = () => mq.matches;
    // orientationchange can fire a touch before matchMedia settles on some phones.
    const onTurn = (fn: () => void) => {
      mq.addEventListener('change', fn);
      window.addEventListener('orientationchange', () => setTimeout(fn, 120));
    };

    if (isCinematicPage) {
      // CSS shows/hides the gate by orientation. If we arrived here in portrait,
      // reload on the first landscape so the cinematic intro starts fresh.
      if (isPortrait()) {
        onTurn(() => { if (!isPortrait()) location.reload(); });
      }
    } else {
      // Hold navigation into the dream until the phone is turned.
      let pending: string | null = null;
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const target = e.target as Element | null;
        const a = target && target.closest ? target.closest('a[href]') as HTMLAnchorElement | null : null;
        if (!a || a.target === '_blank') return;
        let url: URL;
        try { url = new URL(a.getAttribute('href') as string, location.href); } catch { return; }
        if (url.origin !== location.origin || !CINEMATIC.test(url.pathname)) return;
        if (!isPortrait()) return;                  // desktop / landscape → normal navigation
        e.preventDefault();
        e.stopPropagation();                        // beat page-specific link handlers (e.g. curtain fade)
        pending = url.href;
        gate.classList.add('open');
      }, true);                                     // capture, so we win the click

      onTurn(() => { if (pending && !isPortrait()) location.href = pending; });

      // Tap the gate to change your mind and stay on this page.
      gate.addEventListener('click', () => { pending = null; gate.classList.remove('open'); });
    }
  }
</script>
