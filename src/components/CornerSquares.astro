---
// CornerSquares.astro — two simple crenellation squares covering left and right seams
// Positioned directly above the wall panel seams

interface Props {
    crenBg?: string;
}

const { crenBg } = Astro.props;
---

<!-- Left seam square -->
<svg class="corner-square corner-square-left" viewBox="0 -100 114.29 220" preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg">
    {crenBg && <image href={crenBg} x="0" y="-100" width="114.29" height="220" preserveAspectRatio="xMidYMid slice"/>}
    <polygon points="0,-95 0,105 114.29,120 114.29,-80" fill="url(#crenTrapSlightShadow)" stroke="none"/>
    <polygon points="0,105 0,120 114.29,120" fill="url(#crenTrapShadow)" stroke="none"/>
</svg>

<!-- Right seam square -->
<svg class="corner-square corner-square-right" viewBox="1485.71 -100 114.29 220" preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg">
    {crenBg && <image href={crenBg} x="1485.71" y="-100" width="114.29" height="220" preserveAspectRatio="xMidYMid slice"/>}
    <polygon points="1485.71,-80 1485.71,120 1600,105 1600,-95" fill="url(#crenTrapSlightShadow)" stroke="none"/>
    <polygon points="1485.71,120 1600,120 1600,105" fill="url(#crenTrapShadow)" stroke="none"/>
</svg>

<style>
    .corner-square {
        position: absolute;
        width: calc(var(--wall-w) * 114.29 / 1600);
        bottom: 100%;
        pointer-events: none;
        z-index: 3;
    }

    .corner-square-left {
        left: 0;
    }

    .corner-square-right {
        right: 0;
    }
</style>
